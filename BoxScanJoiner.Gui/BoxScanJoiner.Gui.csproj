<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishSingleFile>true</PublishSingleFile>
        <!-- OpenCV (and Skia/HarfBuzz for the GUI) are native; bundle them into the single file too -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <!-- Published apps carry the .NET runtime; regular builds and the tests that reference them stay framework-dependent -->
    <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
        <SelfContained>true</SelfContained>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BoxScanJoiner.Core\BoxScanJoiner.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Localization\UI.resx">
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>BoxScanJoiner.Gui.Localization</StronglyTypedNamespace>
            <StronglyTypedClassName>UI</StronglyTypedClassName>
            <StronglyTypedFileName>$(IntermediateOutputPath)UI.Designer.cs</StronglyTypedFileName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
    </ItemGroup>

</Project>
