<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BoxScanJoiner.Core\BoxScanJoiner.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Localization\UI.resx">
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>BoxScanJoiner.Gui.Localization</StronglyTypedNamespace>
            <StronglyTypedClassName>UI</StronglyTypedClassName>
            <StronglyTypedFileName>$(IntermediateOutputPath)UI.Designer.cs</StronglyTypedFileName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
    </ItemGroup>

</Project>
